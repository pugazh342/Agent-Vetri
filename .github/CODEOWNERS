# Paths that need the maintainer's approval before merge. This replaces the
# ``ci-reviewed`` label gate: GitHub requests the review and enforces it
# (ruleset: "Require review from Code Owners"), so CI no longer needs to
# classify these paths, check a label, or rerun jobs when one is added.
#
# Last match wins; every rule below has the same owner, so order is moot.
# Patterns without a leading slash match at any depth.

# Workflows, composite actions, and this file: they decide what CI executes
# and what the autofix job pushes to main. The scripts the workflows run get the
# same review for the same reason.
/.github/                       @pugazh342
/scripts/ci/                    @pugazh342
# The code-health gate decides whether a PR passes; weakening it is a CI change.
/scripts/check                  @pugazh342
/scripts/code_health/           @pugazh342

# The committed system prompt + tools[] render every session sends (scripts/ci/prompt_surface.py).
# The prompt-surface-review ruleset requires one owner approval here; this line requests it.
/tests/fixtures/prompt_surface/ @pugazh342

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @pugazh342
/.prettierrc                    @pugazh342

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @pugazh342
/vetri_cli/mcp_catalog.py      @pugazh342

# Files that execute at pip-install or interpreter startup.
/setup.py                       @pugazh342
/setup.cfg                      @pugazh342
/sitecustomize.py               @pugazh342
/usercustomize.py               @pugazh342
*.pth                           @pugazh342

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @pugazh342
package.json                    @pugazh342
uv.lock                         @pugazh342
*package-lock.json              @pugazh342
/flake.lock                     @pugazh342
/pm/lock.json                   @pugazh342
*Dockerfile                     @pugazh342

# The npm supply-chain quarantine (min-release-age) lives here.
.npmrc                          @pugazh342

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @pugazh342

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @pugazh342
/scripts/install.ps1            @pugazh342
/scripts/install.cmd            @pugazh342
/scripts/gen-bootstrap-pins.py  @pugazh342

# The trust model and the scope authority for security reports.
/SECURITY.md                    @pugazh342

# Each entry pins a third-party repo by sha; editing it changes what users install.
/plugin-catalog/                @pugazh342
