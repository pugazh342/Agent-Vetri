#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Vetri dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `vetri` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-vetri-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `vetri pm
# install` and `vetri update` keep that check.
# ============================================================================
_VETRI_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_vetri_test_env="--test-environment"
_vetri_expect_extras=""
for _vetri_arg in "$@"; do
    if [ -n "$_vetri_expect_extras" ]; then
        _vetri_test_env="--test-environment=$_vetri_arg"
        _vetri_expect_extras=""
        continue
    fi
    case "$_vetri_arg" in
        --) break ;;
        --test-extras) _vetri_expect_extras=1 ;;
        --test-extras=*) _vetri_test_env="--test-environment=${_vetri_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_vetri_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _vetri_arg _vetri_test_env _vetri_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _vetri_arg _vetri_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_VETRI_REPO/scripts/_activation.sh"

if ! vetri_sync "$_VETRI_REPO" "$_vetri_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _vetri_test_env
    return 1 2>/dev/null || exit 1
fi
unset _vetri_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __VETRI_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_vetri_script="$(vetri_compose_env "$_VETRI_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _vetri_script
    return 1 2>/dev/null || exit 1
}
_vetri_keys="$(printf '%s\n' "$_vetri_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __VETRI_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__VETRI_SAVED_PATH="$PATH"
for _vetri_k in $_vetri_keys; do
    eval "__VETRI_SAVED_$_vetri_k=\"\${$_vetri_k+set}\""
    eval "__VETRI_PRIOR_$_vetri_k=\${$_vetri_k-__VETRI_UNSET__}"
done
vetri_apply_env "$_vetri_script"

# This checkout, not whichever `vetri` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__VETRI_WORKTREE="$_VETRI_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__VETRI_WORKTREE_NAME="$(git -C "$_VETRI_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__VETRI_WORKTREE_NAME" ] || [ "$__VETRI_WORKTREE_NAME" = HEAD ]; then
    __VETRI_WORKTREE_NAME="$(basename "$_VETRI_REPO")"
fi
__VETRI_SAVED_PS1="${PS1-__VETRI_UNSET__}"
__VETRI_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__VETRI_UNSET__}"

_vetri_worktree_here() {
    _vetri_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_vetri_top" && pwd -P)" = "$(cd "$__VETRI_WORKTREE" && pwd -P)" ]
}

vetri() {
    _vetri_worktree_here || {
        printf '%s\n' "vetri: $(pwd) is outside $__VETRI_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__VETRI_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" vetri "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe vetri "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python vetri "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe vetri "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python vetri "$@"
        else
            exec python vetri "$@"
        fi
    )
}

_vetri_prompt() {
    if [ "$__VETRI_SAVED_PS1" = "__VETRI_UNSET__" ]; then
        _vetri_base_ps1=""
    else
        _vetri_base_ps1="$__VETRI_SAVED_PS1"
    fi
    if _vetri_worktree_here; then
        PS1="($__VETRI_WORKTREE_NAME) $_vetri_base_ps1"
    else
        PS1="$_vetri_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_vetri_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_vetri_prompt
fi
_vetri_prompt

deactivate() {
    export PATH="$__VETRI_SAVED_PATH"
    for _vetri_k in $__VETRI_KEY_LIST; do
        eval "_vetri_was=\"\$__VETRI_SAVED_$_vetri_k\""
        eval "_vetri_old=\"\$__VETRI_PRIOR_$_vetri_k\""
        if [ "$_vetri_was" != "set" ]; then
            unset "$_vetri_k"
        else
            export "$_vetri_k=$_vetri_old"
        fi
        unset "__VETRI_SAVED_$_vetri_k" "__VETRI_PRIOR_$_vetri_k"
    done
    if [ "$__VETRI_SAVED_PS1" = "__VETRI_UNSET__" ]; then
        unset PS1
    else
        PS1="$__VETRI_SAVED_PS1"
    fi
    if [ "$__VETRI_SAVED_PROMPT_COMMAND" = "__VETRI_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__VETRI_SAVED_PROMPT_COMMAND"
    fi
    unset __VETRI_SAVED_PATH __VETRI_KEY_LIST __VETRI_ACTIVATED \
          __VETRI_WORKTREE __VETRI_WORKTREE_NAME \
          __VETRI_SAVED_PS1 __VETRI_SAVED_PROMPT_COMMAND
    unset -f deactivate vetri _vetri_worktree_here _vetri_prompt
    unset _vetri_k _vetri_was _vetri_old _vetri_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__VETRI_KEY_LIST="$_vetri_keys"

# The composition library is not part of the user's shell.
unset -f vetri_sync vetri_bootstrap_python vetri_compose_env vetri_apply_env \
         vetri_activation_current vetri_ensure_env
unset _VETRI_REPO _vetri_script _vetri_keys _vetri_k _vetri_top
